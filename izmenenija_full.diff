+
+    # тот же отчёт брокера (3 == учтённым 3): повторная регистрация запрещена
+    client.order_states[oid] = fake_state(CANCELLED, lots_executed=3, price_units=300)
+    await main.poll_open_orders(client, monitor, FakeRM(), ledger)
