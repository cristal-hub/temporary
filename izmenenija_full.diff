+        logging.info(
+            f"[ledger] Загружено переходов: {records}, заявок: {len(self._latest)}"
+            + ("" if self._reliable else "; РЕЕСТР НЕДОСТОВЕРЕН — новые BUY запрещены")
+            + "."
