+
+    @staticmethod
+    def _normalize(rec: dict) -> dict:
+        out = {k: rec.get(k) for k in RECORD_FIELDS}
+        out["order_id"] = str(rec.get("order_id"))
+        out["status"] = str(rec.get("status"))
